#!/usr/bin/env bash
# Prepare a release without committing; finalize an already-reviewed release commit.
set -euo pipefail

usage() {
	cat <<'EOF'
Usage:
  scripts/release/release-tag prepare vX.Y.Z
  scripts/release/release-tag finalize vX.Y.Z

prepare updates version metadata, CHANGELOG.md, and generated outputs without
committing or tagging. Review and commit those changes, then finalize validates
the clean release commit and creates a local annotated tag. Neither step pushes.
EOF
}

if [ "$#" -ne 2 ]; then
	usage >&2
	exit 2
fi

MODE="$1"
TAG="$2"
VERSION="${TAG#v}"
if [[ "$MODE" != "prepare" && "$MODE" != "finalize" ]]; then
	usage >&2
	exit 2
fi
if ! [[ "$TAG" =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
	echo "ERROR: '$TAG' is not a valid semver tag (expected vX.Y.Z)" >&2
	exit 1
fi

check_clean_tree() {
	if [ -n "$(git status --porcelain)" ]; then
		echo "ERROR: working tree is not clean — commit or stash changes first" >&2
		exit 1
	fi
}

check_tag_available() {
	if git rev-parse --verify --quiet "refs/tags/$TAG" >/dev/null; then
		echo "ERROR: local tag '$TAG' already exists; tags are never moved" >&2
		exit 1
	fi

	while IFS= read -r remote; do
		[ -n "$remote" ] || continue
		set +e
		git ls-remote --exit-code --refs "$remote" "refs/tags/$TAG" >/dev/null
		status=$?
		set -e
		case "$status" in
		0)
			echo "ERROR: tag '$TAG' already exists on remote '$remote'; tags are never moved" >&2
			exit 1
			;;
		2) ;;
		*)
			echo "ERROR: could not verify tag '$TAG' on remote '$remote'" >&2
			exit 1
			;;
		esac
	done < <(git remote)
}

check_clean_tree
check_tag_available

PACKAGE_JSONS=(src/.agentbundler/packages/*.json)
PROJECT_VERSION_FILES=(
	agentbundle.json
	pyproject.toml
	uv.lock
	package.json
	src/skills/playwright-skill/scripts/package.json
)
if [ ! -f "${PACKAGE_JSONS[0]}" ]; then
	echo "ERROR: no src/.agentbundler/packages/*.json files found" >&2
	exit 1
fi
for file in "${PROJECT_VERSION_FILES[@]}" "${PACKAGE_JSONS[@]}" CHANGELOG.md; do
	if [ ! -f "$file" ]; then
		echo "ERROR: expected release file missing: $file" >&2
		exit 1
	fi
done

CHECKER="src/skills/releasing-code/scripts/release_notes.py"
if [ ! -f "$CHECKER" ]; then
	echo "ERROR: release notes checker is missing: $CHECKER" >&2
	exit 1
fi

if [[ "$MODE" == "prepare" ]]; then
	if ! grep -Fqx '## [Unreleased]' CHANGELOG.md; then
		echo "ERROR: CHANGELOG.md missing ## [Unreleased] marker" >&2
		exit 1
	fi
	python3 "$CHECKER" check-versions --root .
	python3 - "$VERSION" <<'PY'
import sys
import tomllib
from pathlib import Path


def semver(value):
    try:
        parts = tuple(int(part) for part in value.split("."))
    except (AttributeError, ValueError):
        raise SystemExit(f"ERROR: invalid existing version: {value!r}")
    if len(parts) != 3:
        raise SystemExit(f"ERROR: invalid existing version: {value!r}")
    return parts


target = sys.argv[1]
project_version = tomllib.loads(Path("pyproject.toml").read_text())["project"]["version"]
if semver(target) <= semver(project_version):
    raise SystemExit(
        f"ERROR: target {target} must be greater than current project version {project_version}"
    )
PY

	echo "Preparing release $TAG (no commit or tag will be created)..."
	sed_inplace() {
		local expression="$1" file="$2"
		sed -i.release-tag.bak "$expression" "$file"
		rm -f "$file.release-tag.bak"
	}
	update_agentbundle_version() {
		python3 - "$1" "$VERSION" <<'PY'
import json
import sys
from pathlib import Path

path = Path(sys.argv[1])
version = sys.argv[2]
data = json.loads(path.read_text())
data["distribution"]["version"] = version
for output in data["composition"]:
    aggregate = output.get("aggregate")
    if aggregate is not None:
        aggregate["metadata"]["version"] = version
path.write_text(json.dumps(data, indent=2) + "\n")
PY
	}

	for file in "${PACKAGE_JSONS[@]}"; do
		sed_inplace 's/"version": "[^"]*"/"version": "'"$VERSION"'"/' "$file"
	done
	for file in "${PROJECT_VERSION_FILES[@]}"; do
		if [[ "$file" == "agentbundle.json" ]]; then
			update_agentbundle_version "$file"
		elif [[ "$file" == "uv.lock" ]]; then
			uv lock
		elif [[ "$file" == *.toml ]]; then
			sed_inplace "s/^version = .*/version = \"$VERSION\"/" "$file"
		else
			sed_inplace 's/"version": "[^"]*"/"version": "'"$VERSION"'"/' "$file"
		fi
	done

	make build

	if ! grep -Fq "## [$VERSION]" CHANGELOG.md; then
		date_string=$(date +%Y-%m-%d)
		python3 - "$VERSION" "$date_string" <<'PY'
import sys
from pathlib import Path

version, date = sys.argv[1:3]
path = Path("CHANGELOG.md")
text = path.read_text()
marker = "## [Unreleased]"
if marker not in text:
    raise SystemExit("ERROR: CHANGELOG.md missing ## [Unreleased] marker")
entry = f"\n\n## [{version}] - {date}\n"
path.write_text(text.replace(marker, marker + entry, 1))
PY
	fi

	cat <<EOF

Prepared $TAG. No commit, tag, or push was performed.
Review CHANGELOG.md and generated output, then commit the release changes.
Run 'scripts/release/release-tag finalize $TAG' only on that clean, validated commit.
EOF
	exit 0
fi

python3 "$CHECKER" check-release --root . --tag "$TAG" --changelog CHANGELOG.md

parent=$(git rev-parse --verify --quiet HEAD^) || {
	echo "ERROR: finalize requires a committed release revision" >&2
	exit 1
}
changed_files=$(git diff-tree --no-commit-id --name-only -r HEAD)
for required_file in CHANGELOG.md agentbundle.json pyproject.toml uv.lock package.json src/skills/playwright-skill/scripts/package.json; do
	if ! grep -Fxq "$required_file" <<<"$changed_files"; then
		echo "ERROR: HEAD is not the release commit; missing committed change: $required_file" >&2
		exit 1
	fi
done
for file in "${PACKAGE_JSONS[@]}"; do
	if ! grep -Fxq "$file" <<<"$changed_files"; then
		echo "ERROR: HEAD is not the release commit; package version manifest is not committed: $file" >&2
		exit 1
	fi
done
if ! grep -q '^dist/' <<<"$changed_files"; then
	echo "ERROR: HEAD is not the release commit; generated dist/ output is not committed" >&2
	exit 1
fi

printf 'Validating clean release commit %s with make ci...\n' "$parent"
make ci
check_clean_tree
check_tag_available

git tag --annotate "$TAG" --message "Release $TAG"
printf 'Created local annotated tag %s at %s. No push was performed.\n' "$TAG" "$(git rev-parse --short HEAD)"
