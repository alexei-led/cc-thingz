{
  "event": "prompt-submit",
  "handler": {
    "mode": "exec",
    "program": "python3",
    "arguments": [
      {
        "packageFile": "hook.py"
      }
    ]
  },
  "timeoutMilliseconds": 3000,
  "asynchronous": false,
  "failurePolicy": "open",
  "order": 20,
  "environment": ["HOOK_SKILL_ENFORCER"]
}
