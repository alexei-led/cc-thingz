{
  "event": "pre-tool",
  "matcher": {
    "tools": ["command"]
  },
  "handler": {
    "mode": "exec",
    "program": "bash",
    "arguments": [
      {
        "packageFile": "hook.sh"
      },
      {
        "packageFile": "decide.py"
      }
    ]
  },
  "timeoutMilliseconds": 10000,
  "asynchronous": false,
  "failurePolicy": "closed",
  "environment": ["CLAUDE_HOOK_CONFIG"],
  "order": 40
}
